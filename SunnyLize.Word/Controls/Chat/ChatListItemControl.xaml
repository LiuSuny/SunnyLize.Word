<UserControl x:Class="SunnyLize.Word.ChatListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SunnyLize.Word"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="300">
    <Grid Background="{StaticResource ForegroundLightBrush}">
        <Grid.ColumnDefinitions>
            <!--New message indicator bar-->
            <ColumnDefinition Width="Auto"/>
            
            <!--Profile picture-->
            <ColumnDefinition Width="Auto"/>
            
            <!--Main contents-->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--New message indicator bar-->
        <Border Background="Red" Width="5"/>

            <!--Profile picture-->
        <Border Grid.Column="1" Padding="8">
            <!--Profile picture background-->
            <Border Background="{StaticResource WordBlueBrush}"
                    Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                    CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                    >
                <!--Profile picture initials-->
                <TextBlock Text="LM"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource BackgroundLightBrush}"
                           FontSize="{StaticResource FontSizeAverage}"
                           FontFamily="{StaticResource LatoRegular}"
                           
                           />
            </Border>
            
        </Border>
        <!--Main contents of our chat message-->
        <StackPanel>
            
        </StackPanel>
    </Grid>
</UserControl>
