<UserControl x:Class="SunnyLize.Word.ChatMessageListItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SunnyLize.Word"
               xmlns:core="clr-namespace:SunnyLize.Word.Core;assembly=SunnyLize.Word.Core"
             mc:Ignorable="d" 
             d:DesignWidth="300">
    <Border Padding="5" Background="{StaticResource WordBlueBrush}">
        <Grid>

            <!--Profile picture-->
            <Border VerticalAlignment="Top"
                    Margin="0 7.5 0 7.5"
                    HorizontalAlignment="Left"
                    CornerRadius="{Binding ActualWidth, RelativeSource= {RelativeSource Self}}"
                    Height="{Binding ActualWidth, RelativeSource= {RelativeSource Self}}"
                    Width="35"
                    Background="Green"
                    BorderBrush="{StaticResource ForegroundLightBrush}"
                    BorderThickness="1"
                    >
                <TextBlock Text="LM"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource ForegroundLightBrush}"
                           FontFamily="{StaticResource LatoRegular}"
                           />
            </Border>

            <!--Chat message container-->
            <Grid Margin="25 0 0 0" HorizontalAlignment="Left">
                
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--Speech bubble rectange-->
                <Border CornerRadius="10"
                    Padding="15"   
                    Background="{StaticResource ForegroundLightBrush}" 
                    >
                    <!--Message text-->
                    <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource LatoRegular}"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource WordDarkBlueBrush}"
                           Text="This chat app is awesome! when is it coming out ? I want to use it on my system"/>

                </Border>

                <!--chat bubble Anchor icon (from Path Markup Syntax)-->
                <Path Grid.Row="1"
                      Stroke="Black"
                      Panel.ZIndex="1"
                      Margin="15,-1,15,0"
                      Data="M 0,0 L 10,10 L 20,0 L 0,0"
                      StrokeThickness="0"
                      Fill="{StaticResource ForegroundLightBrush}" />

                <!--Add chat time manually-->
                <TextBlock
                          Grid.Row="2"
                          Text="11:55am"
                           Foreground="{StaticResource ForegroundLightBrush}"
                          HorizontalAlignment="Right"
                           FontSize="{StaticResource FontSizeSmall}"                   
                           />
            </Grid>
        </Grid>
    </Border>
</UserControl>
