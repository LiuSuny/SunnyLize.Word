<UserControl x:Class="SunnyLize.Word.SettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SunnyLize.Word"
             mc:Ignorable="d">
          

    <Border Background="{StaticResource ForegroundLightBrush}"
            Padding="15">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!--Setting Title-->
        <Grid Height="40" Margin="0 0 0 20">
            <!--Back button-->
            <Button Style="{StaticResource IconGrowButton}"
                    Height="40"
                    Content="{StaticResource FontAwesomeArrowLeftIcon}"
                    FontFamily="{StaticResource FontAwesome}"
                    Foreground="{StaticResource ForegroundDarkBrush}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"  
                    Command="{Binding CloseSettingsCommand}"
                    />

            <!--Setting header-->
            <TextBlock FontSize="{StaticResource FontSizeLarge}"
                       Foreground="{StaticResource ForegroundVeryDarkBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"                       
                       >
                
                <!--Cog icon-->
                    <Run FontFamily="{StaticResource FontAwesome}"
                         Text="{StaticResource FontAwesomeCogIcon}"
                         Foreground="{StaticResource WordOrangeBrush}"
                        
                         />
                     
                
                     <!--Setting text-->
                    <Run Text="Settings"                        
                         FontFamily="{StaticResource LatoRegular}"
                       
                         />


            </TextBlock>
        </Grid>
        
        <!--Main content-->

            <Grid Grid.Row="1"
                  Width="700"               
                  VerticalAlignment="Top"
                  >
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!--Profile picture-->

                <Grid  Margin="0 0 10 0"
                       Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}">

                    <Border CornerRadius="8"
                             Name="Mask"
                            Background="White"/>

                    <Grid>
                        <Grid.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=Mask}"/>
                        </Grid.OpacityMask>
                        <Image Source="/Images/Samples/ParisPix.jpg" Stretch="UniformToFill"/>
                    </Grid>

                </Grid>
                                              
                <!--several way to padding using class local:PenelChildMarginProperty.Value="5-->
                <!--Profile Details-->
                <Grid Grid.Column="1"
                      local:PenelChildMarginProperty.Value="15 8"
                      >

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition  Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!--Profile name-->
                    <TextBlock Text="Name"
                               FontFamily="{StaticResource LatoRegular}"
                               />
                    
                    <!--Profile Username-->
                    <TextBlock Text="Username" Grid.Row="1"
                               FontFamily="{StaticResource LatoRegular}"
                               />
                    
                    <!--User password-->
                    <TextBlock Text="Password" Grid.Row="2"
                               FontFamily="{StaticResource LatoRegular}"
                               />
                    
                    <!--Email-->
                    <TextBlock Text="Email" Grid.Row="3"
                               FontFamily="{StaticResource LatoRegular}"
                               />

                 
                    <!--contents-->
                    <TextBlock Text="Luke Rowland" Grid.Column="1"  />
                    <TextBlock Text="Luke " Grid.Column="1" Grid.Row="1" />
                    <TextBlock Text="*******" Grid.Column="1"  Grid.Row="2"/>
                    <TextBlock Text="johndoe@Gmail.com" Grid.Column="1"  Grid.Row="3"/>


                </Grid>
            </Grid>

            
        
    </Grid>
    </Border>
</UserControl>
